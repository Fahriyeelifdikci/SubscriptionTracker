@using System.Globalization
@using System.Text.Json
@model DashboardViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var invariant = CultureInfo.InvariantCulture;
    var categoryLabelsJson = JsonSerializer.Serialize(Model.CategoryCosts.Select(c => c.CategoryName));
    var categoryValuesJson = JsonSerializer.Serialize(Model.CategoryCosts.Select(c => c.MonthlyCost));
    var monthlyTotalJson = JsonSerializer.Serialize(Model.MonthlyTotal);
}


@if (TempData["BudgetSuccess"] != null)
{
    <div class="alert alert-success" role="status">@TempData["BudgetSuccess"]</div>
}
@if (TempData["BudgetError"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["BudgetError"]</div>
}

<section class="card mb-4" aria-labelledby="budgetTitle">
    <div class="card-header">
        <h2 class="h5 mb-0" id="budgetTitle">Aylık Bütçe Yönetimi</h2>
    </div>
    <div class="card-body">
        <form asp-controller="Dashboard" asp-action="SaveBudget" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label for="monthlyLimit" class="form-label">Aylık bütçe limitin (₺)</label>
                <input id="monthlyLimit" type="number" name="monthlyLimit" class="form-control"
                       min="0.01" max="100000000" step="0.01"
                       value="@(Model.MonthlyBudget?.ToString("0.00", invariant))" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Bütçeyi Kaydet</button>
            </div>
        </form>

        @if (Model.MonthlyBudget.HasValue)
        {
            var percentage = Model.BudgetUsagePercentage;
            var progressWidth = Math.Clamp(percentage, 0m, 100m);
            var progressClass = percentage >= 100 ? "bg-danger" : percentage >= 80 ? "bg-warning" : "bg-success";

            <hr />
            <div class="d-flex justify-content-between gap-3">
                <span>Aylık ortalama gider</span>
                <strong>@Model.MonthlyTotal.ToString("N2", tr) ₺</strong>
            </div>
            <div class="d-flex justify-content-between gap-3 mt-2">
                <span>Bütçe limiti</span>
                <strong>@Model.MonthlyBudget.Value.ToString("N2", tr) ₺</strong>
            </div>
            <div class="progress mt-3" style="height: 15px;" aria-label="Bütçe kullanım oranı">
                <div class="progress-bar @progressClass" role="progressbar"
                     style="width: @(progressWidth.ToString(invariant))%;"
                     aria-valuenow="@(progressWidth.ToString(invariant))"
                     aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <p class="mt-2">Bütçe kullanımı: <strong>@percentage.ToString("N1", tr)%</strong></p>

            @if (percentage >= 100)
            {
                <div class="alert alert-danger mb-0" role="alert">
                    Bütçe limitini aştın! Aşım tutarı: @((-Model.RemainingBudget).ToString("N2", tr)) ₺.
                </div>
            }
            else if (percentage >= 80)
            {
                <div class="alert alert-warning mb-0" role="status">
                    Dikkat! Aylık bütçe limitine yaklaşıyorsun. Kalan: @Model.RemainingBudget.ToString("N2", tr) ₺.
                </div>
            }
            else
            {
                <div class="alert alert-success mb-0" role="status">
                    Bütçen kontrol altında. Kalan tutar: @Model.RemainingBudget.ToString("N2", tr) ₺.
                </div>
            }
        }
    </div>
</section>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">
        Henüz bir aboneliğin yok.
        <a asp-controller="Subscriptions" asp-action="Create">İlk aboneliğini ekle</a>.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Aylık abonelik gideri</div>
                <div class="fs-4 fw-semibold">@Model.MonthlyTotal.ToString("N2", tr) ₺</div>
                <div class="text-muted small">Yıllıklar 12'ye bölünerek</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Tahmini yıllık gider</div>
                <div class="fs-4 fw-semibold">@Model.YearlyTotal.ToString("N2", tr) ₺</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Aktif abonelik</div>
                <div class="fs-4 fw-semibold">@Model.ActiveCount</div>
                <div class="text-muted small">Toplam kayıt: @Model.TotalCount</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Bu ay yapılacak ödemeler</div>
                <div class="fs-4 fw-semibold">@Model.ThisMonthPaymentTotal.ToString("N2", tr) ₺</div>
                <div class="text-muted small">@Model.ThisMonthPaymentCount ödeme</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Yaklaşan ödemeler (30 gün)</div>
                <ul class="list-group list-group-flush">
                    @if (!Model.UpcomingPayments.Any())
                    {
                        <li class="list-group-item text-muted">Önümüzdeki 30 günde ödeme görünmüyor.</li>
                    }
                    @foreach (var p in Model.UpcomingPayments)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div>
                                <div>@p.Name</div>
                                <div class="text-muted small">
                                    @(p.DaysLeft == 0 ? "Bugün" : p.DaysLeft == 1 ? "Yarın" : $"{p.DaysLeft} gün sonra")
                                    · @p.NextPaymentDate.ToString("dd.MM.yyyy")
                                </div>
                            </div>
                            <span class="fw-semibold text-nowrap">@p.Price.ToString("N2", tr) ₺</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Kategoriye göre aylık gider</div>
                <ul class="list-group list-group-flush">
                    @if (!Model.CategoryCosts.Any())
                    {
                        <li class="list-group-item text-muted">Aktif abonelik bulunmuyor.</li>
                    }
                    @foreach (var c in Model.CategoryCosts)
                    {
                        <li class="list-group-item d-flex justify-content-between gap-2">
                            <span>@c.CategoryName</span>
                            <span class="fw-semibold text-nowrap">@c.MonthlyCost.ToString("N2", tr) ₺</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <p class="text-muted small mt-3">Giderlere yalnızca aktif abonelikler dahildir.</p>

    <div class="row g-4 mt-2 mb-4">
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header"><h2 class="h5 mb-0">Kategori Bazında Harcamalar</h2></div>
                <div class="card-body">
                    @if (Model.CategoryCosts.Any())
                    {
                        <div style="height: 300px; position: relative;">
                            <canvas id="categoryChart" role="img" aria-label="Kategorilere göre aylık harcama dağılımı"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Grafik için aktif abonelik bulunmuyor.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header"><h2 class="h5 mb-0">Gelecek 6 Ayın Tahmini Giderleri</h2></div>
                <div class="card-body">
                    @if (Model.ActiveCount > 0)
                    {
                        <div style="height: 300px; position: relative;">
                            <canvas id="forecastChart" role="img" aria-label="Gelecek altı ayın aylık eşdeğer harcamaları"></canvas>
                        </div>
                        <p class="text-muted small mt-3 mb-0">
                            Her ay için aynı aylık eşdeğer maliyet gösterilir. Bu grafik gerçek ödeme tarihlerini değil,
                            aktif aboneliklerin aylık ortalama giderini temel alır.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted text-center">Tahmin için aktif abonelik bulunmuyor.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (Model.ActiveCount > 0)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof Chart === "undefined") {
                console.error("Chart.js yüklenemedi.");
                return;
            }

            const categoryLabels = @Html.Raw(categoryLabelsJson);
            const categoryValues = @Html.Raw(categoryValuesJson);
            const monthlyTotal = @Html.Raw(monthlyTotalJson);
            const currency = value => Number(value).toLocaleString("tr-TR", {
                style: "currency", currency: "TRY"
            });

            const categoryCanvas = document.getElementById("categoryChart");
            if (categoryCanvas && categoryValues.length > 0) {
                new Chart(categoryCanvas, {
                    type: "doughnut",
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryValues,
                            backgroundColor: ["#6366f1", "#06b6d4", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#64748b"],
                            borderWidth: 2,
                            borderColor: "#ffffff"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: "bottom" },
                            tooltip: {
                                callbacks: {
                                    label: context => `${context.label}: ${currency(context.parsed)}`
                                }
                            }
                        }
                    }
                });
            }

            const now = new Date();
            const monthLabels = [];
            for (let i = 1; i <= 6; i++) {
                const date = new Date(now.getFullYear(), now.getMonth() + i, 1);
                monthLabels.push(date.toLocaleDateString("tr-TR", { month: "long", year: "numeric" }));
            }
            const forecastCanvas = document.getElementById("forecastChart");
            if (forecastCanvas) {
                new Chart(forecastCanvas, {
                    type: "bar",
                    data: {
                        labels: monthLabels,
                        datasets: [{
                            label: "Aylık eşdeğer gider (₺)",
                            data: Array(6).fill(monthlyTotal),
                            backgroundColor: "#6366f1",
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, ticks: { callback: value => `${Number(value).toLocaleString("tr-TR")} ₺` } }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: context => currency(context.parsed.y) } }
                        }
                    }
                });
            }
        });
    </script>
}
