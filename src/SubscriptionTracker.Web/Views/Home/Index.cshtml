@{
    ViewData["Title"] = "Hoş geldin";
}

<div class="text-center py-5">
    <h1 class="display-5 fw-bold">💳 Subscription Tracker</h1>
    <p class="lead text-muted mb-4">
        Netflix'ten faturalara bütün düzenli ödemelerini tek yerden takip et,
        bütçeni aşmadan önce haberin olsun.
    </p>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">Kayıt ol</a>
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg">Giriş yap</a>
</div>