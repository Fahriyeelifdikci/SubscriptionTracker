@using System.Globalization
@model SubscriptionIndexViewModel

@{
    ViewData["Title"] = "Aboneliklerim";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Aboneliklerim</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Abonelik</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <input asp-for="Search" class="form-control" placeholder="Abonelik ara..." />
    </div>
    <div class="col-md-2">
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="">Tüm kategoriler</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="isActive" class="form-select">
            <option value="">Tüm durumlar</option>
            <option value="true" selected="@(Model.IsActive == true)">Aktif</option>
            <option value="false" selected="@(Model.IsActive == false)">Pasif</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="billingPeriod" class="form-select">
            <option value="">Tüm periyotlar</option>
            <option value="1" selected="@(Model.BillingPeriod == BillingPeriod.Monthly)">Aylık</option>
            <option value="2" selected="@(Model.BillingPeriod == BillingPeriod.Yearly)">Yıllık</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Filtrele</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

@if (!Model.Items.Any())
{
    if (Model.HasFilters)
    {
        <div class="alert alert-info">Seçtiğin filtrelere uygun abonelik bulunamadı.</div>
    }
    else
    {
        <div class="alert alert-info">Henüz bir aboneliğin yok. "Yeni Abonelik" ile ilkini ekleyebilirsin.</div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Kategori</th>
                    <th class="text-end">Ücret</th>
                    <th>Periyot</th>
                    <th>Sonraki Ödeme</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.CategoryName</td>
                        <td class="text-end">@item.Price.ToString("N2", tr) ₺</td>
                        <td>@Html.DisplayFor(_ => item.BillingPeriod)</td>
                        <td>@item.NextPaymentDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}