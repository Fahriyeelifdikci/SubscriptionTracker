@model SubscriptionFormViewModel

@{
    ViewData["Title"] = "Aboneliği Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-4">Aboneliği Düzenle</h1>

        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            <partial name="_SubscriptionForm" model="Model" />

            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}