
@model SubscriptionTracker.Web.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Hesap Ayarları";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 fw-bold">Hesap Ayarları</h1>
        <p class="text-muted">
            Hesap bilgilerinizi görüntüleyebilir
            ve şifrenizi değiştirebilirsiniz.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">

        <!-- Hesap bilgileri -->
        <div class="col-lg-5">
            <div class="card h-100 shadow-sm">

                <div class="card-header">
                    Hesap Bilgileri
                </div>

                <div class="card-body">

                    <label class="form-label text-muted">
                        E-posta Adresi
                    </label>

                    <input type="email"
                           class="form-control"
                           value="@Model.Email"
                           readonly />

                    <p class="small text-muted mt-3">
                        E-posta adresiniz hesabınıza
                        giriş yaparken kullanılır.
                    </p>

                </div>
            </div>
        </div>

        <!-- Şifre değiştirme -->
        <div class="col-lg-7">
            <div class="card shadow-sm">

                <div class="card-header">
                    Şifre Değiştir
                </div>

                <div class="card-body">

                    <form asp-controller="AccountSettings"
                          asp-action="ChangePassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword"
                                   class="form-label">
                                Mevcut Şifre
                            </label>

                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   autocomplete="current-password" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword"
                                   class="form-label">
                                Yeni Şifre
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <small class="text-muted">
                                En az 8 karakter, büyük harf,
                                küçük harf ve rakam içermelidir.
                            </small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Yeni Şifre Tekrar
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Şifremi Güncelle
                        </button>

                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
